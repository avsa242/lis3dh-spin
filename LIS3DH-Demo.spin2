' Uncomment the following two lines to use the driver in SPI mode
'#define LIS3DH_SPI
'#pragma exportdef(LIS3DH_SPI)

#include "core.con.click.spin2"

CON

    _clkfreq    = 180_000_000
    _xtlfreq    = 20_000_000

' -- User-modifiable constants
    CLICK_BASE  = 0
' --


OBJ

    ser:    "com.serial.terminal.ansi" | SER_BAUD=2_000_000

    { for MikroE click boards - modify CLICK_BASE symbol above only }
    sensor: "sensor.accel.3dof.lis3dh" |    {I2C} SCL=SCL_PIN, SDA=SDA_PIN, ...
                                                    I2C_FREQ=400_000, I2C_ADDR=0, ...
                                            {SPI} CS=CS_PIN, SCK=SCK_PIN, MOSI=MOSI_PIN, ...
                                                    MISO=MISO_PIN, SPI_FREQ=1_000_000

    { for custom I/O pin assignments - modify pin numbers below as needed }
'    sensor: "sensor.accel.3dof.lis3dh" |    {I2C} SCL=0, SDA=1, I2C_FREQ=400_000, I2C_ADDR=0, ...
'                                            {SPI} CS=0, SCK=1, MOSI=2, MISO=3, SPI_FREQ=1_000_000
'   NOTE: If LIS3DH_SPI is #defined, and MOSI_PIN and MISO_PIN are the same,
'   the driver will attempt to start in 3-wire SPI mode.


PUB main() | a[3], axis, sign

    setup()

    sensor.preset_active()

    repeat
        ser.pos_xy(0, 3)
        if ( ser.getchar_noblock() == "c" )
            cal_accel()
        repeat
        until sensor.accel_data_rdy()
        sensor.accel_g(@a[sensor.X_AXIS], @a[sensor.Y_AXIS], @a[sensor.Z_AXIS])
        ser.str(@"Accel (g):  ")
        repeat axis from sensor.X_AXIS to sensor.Z_AXIS
            if ( a[axis] < 0 )
                sign := "-"
            else
                sign := " "
            ser.printf(@"%c%d.%06.6d     ", sign, ...
                                            abs(a[axis] / 1_000_000), ...
                                            abs(a[axis] // 1_000_000) )
        ser.newline()


PUB cal_accel()
' Calibrate the accelerometer
    ser.pos_xy(0, 3)
    ser.str(@"Calibrating accelerometer...")
    ser.clear_ln()
    sensor.calibrate_accel()
    ser.pos_xy(0, 3)
    ser.clear_ln()


PUB setup()

    ser.start()

    ser.clear()
    ser.strln(@"Serial terminal started")

    if ( sensor.start() )
        ser.strln(@"LIS3DH driver started")
    else
        ser.strln(@"LIS3DH driver failed to start - halting")
        repeat


DAT
